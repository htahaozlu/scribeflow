 "cells": [
  {
   "cell_type": "markdown",
   "id": "yazit-intro",
   "metadata": {},
   "source": [
    "# Yazıt — Colab transcription\n",
    "\n",
    "Generated by `yazit gen-notebook`. Runs the proven, resumable flow:\n",
    "**mount → install → transcribe → resume**.\n",
    "\n",
    "Heavy I/O (audio chunks, downloads) stays on local `/content`; only the small,\n",
    "durable transcripts + checkpoints go to Google Drive — the Errno-107 split.\n",
    "If the runtime disconnects, just **re-run the last cell**: it resumes from the\n",
    "last completed chunk with no duplication."
   ]
  },
  {
   "cell_type": "code",
   "id": "yazit-mount",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Mount Google Drive (durable output lives here)\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive', force_remount=True)"
   ]
  },
  {
   "cell_type": "code",
   "id": "yazit-install",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Install Yazıt (ffmpeg is preinstalled on Colab)\n",
    "!pip install -q '{{ pip_target }}'"
   ]
  },
  {
   "cell_type": "code",
   "id": "yazit-config",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Configuration — the Errno-107 split is baked in:\n",
    "#    WORKSPACE_DIR = local /content scratch (heavy I/O)\n",
    "#    OUTPUT_DIR    = durable Google Drive (transcripts + checkpoints)\n",
    "SOURCE = {{ source_repr }}\n",
    "OUTPUT_DIR = {{ output_repr }}\n",
    "WORKSPACE_DIR = {{ workspace_repr }}\n",
    "MODEL = {{ model_repr }}\n",
    "BACKEND = {{ backend_repr }}\n",
    "LANGUAGE = {{ language_repr }}\n",
    "CHUNK_MINUTES = {{ chunk_minutes }}"
   ]
  },
  {
   "cell_type": "code",
   "id": "yazit-run",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Transcribe (resumable). Re-run THIS cell after a disconnect to continue.\n",
    "import shlex, subprocess\n",
    "cmd = [\n",
    "    'yazit', 'transcribe', SOURCE,\n",
    "    '--runtime', 'colab',\n",
    "    '--out', OUTPUT_DIR,\n",
    "    '--workspace', WORKSPACE_DIR,\n",
    "    '--language', LANGUAGE,\n",
    "    '--chunk-minutes', str(CHUNK_MINUTES),\n",
    "]\n",
    "if MODEL:\n",
    "    cmd += ['--model', MODEL]\n",
    "if BACKEND:\n",
    "    cmd += ['--backend', BACKEND]\n",
    "print('Running:', ' '.join(shlex.quote(c) for c in cmd))\n",
    "subprocess.run(cmd, check=True)"
   ]
  }
 ],
